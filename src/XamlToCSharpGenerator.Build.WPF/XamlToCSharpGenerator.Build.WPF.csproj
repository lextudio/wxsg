<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>XamlToCSharpGenerator.Build.WPF</PackageId>
    <Description>MSBuild props/targets that wire WXSG (WPF XAML Source Generator) into WPF projects.</Description>
  </PropertyGroup>

  <!--
    Include the buildTransitive props/targets in the NuGet package layout.
    When this package is referenced by a project (directly or transitively),
    MSBuild will automatically import these files.
  -->
  <ItemGroup>
    <None Include="buildTransitive\**\*"
          Pack="true"
          PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Bundle task binaries under buildTransitive/tasks/<TFM>; targets select by MSBuildRuntimeType. -->
  <ItemGroup>
    <None Include="..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net8.0\*"
          Exclude="..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net8.0\Microsoft.Build.*;..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net8.0\Microsoft.NET.StringTools.*"
          Pack="true"
          PackagePath="buildTransitive\tasks\net8.0"
          Visible="false"
          Condition="Exists('..\\XamlToCSharpGenerator.Build.Tasks\\bin\\$(Configuration)\\net8.0\\XamlToCSharpGenerator.Build.Tasks.dll')" />
    <None Include="..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net48\*"
          Exclude="..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net48\Microsoft.Build.*;..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net48\Microsoft.NET.StringTools.*"
          Pack="true"
          PackagePath="buildTransitive\tasks\net48"
          Visible="false"
          Condition="Exists('..\\XamlToCSharpGenerator.Build.Tasks\\bin\\$(Configuration)\\net48\\XamlToCSharpGenerator.Build.Tasks.dll')" />
  </ItemGroup>

  <Target Name="BuildXamlToCSharpGeneratorBuildTasks" BeforeTargets="Pack"
          Condition="Exists('..\\XamlToCSharpGenerator.Build.Tasks\\XamlToCSharpGenerator.Build.Tasks.csproj')">
    <MSBuild Projects="..\XamlToCSharpGenerator.Build.Tasks\XamlToCSharpGenerator.Build.Tasks.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net8.0"
             StopOnFirstFailure="true" />
    <MSBuild Projects="..\XamlToCSharpGenerator.Build.Tasks\XamlToCSharpGenerator.Build.Tasks.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net48"
             StopOnFirstFailure="true" />
  </Target>
</Project>
