<Project>
  <!--
    Mirror WpfXsgEnabled into XamlSourceGenEnabled here (in .targets, not .props) so that
    the project's <WpfXsgEnabled>true</WpfXsgEnabled> is already evaluated before this
    condition is checked.  Properties in .props are evaluated before project content;
    properties in .targets are evaluated after.
  -->
  <!--
    MSBuild's Microsoft.CSharp.Core.targets caps .NETFramework projects at C# 7.3
    (MaxSupportedLangVersion = 7.3 for any TargetFrameworkIdentifier that is not
    .NETCoreApp >= 3.0 or .NETStandard >= 2.1).  WXSG generates code that requires
    nullable reference types (#nullable, C# 8) and the 'not' pattern (C# 9).

    Bump LangVersion to 9.0 when:
      • WpfXsgEnabled is true (WXSG is active)
      • The project language is C#
      • LangVersion is currently a version string that is older than 9.0
        (7, 7.0, 7.1, 7.2, 7.3, 8, 8.0).
    Special string values such as 'latest', 'default', and 'preview' are left
    untouched because they always resolve to a version >= 9 on modern toolchains.
    This PropertyGroup is in .targets (not .props) so it is evaluated AFTER
    Microsoft.CSharp.Core.targets has already set LangVersion = 7.3 for
    .NETFramework targets; our assignment here overrides that value.
  -->
  <PropertyGroup Condition="'$(WpfXsgEnabled)' == 'true' and ('$(Language)' == 'C#' or '$(MSBuildProjectExtension)' == '.csproj')">
    <LangVersion Condition="'$(LangVersion)' == '' or '$(LangVersion)' == '7' or '$(LangVersion)' == '7.0' or '$(LangVersion)' == '7.1' or '$(LangVersion)' == '7.2' or '$(LangVersion)' == '7.3' or '$(LangVersion)' == '8' or '$(LangVersion)' == '8.0'">9.0</LangVersion>
  </PropertyGroup>

  <!-- Forward WpfXsgEmitGeneratedFiles to Roslyn's standard EmitCompilerGeneratedFiles. -->
  <PropertyGroup Condition="'$(WpfXsgEnabled)' == 'true' and '$(WpfXsgEmitGeneratedFiles)' == 'true'">
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <PropertyGroup>
    <WpfXsgTargetLanguageNormalized Condition="'$(WpfXsgTargetLanguage)' == 'C#'">CSharp</WpfXsgTargetLanguageNormalized>
    <WpfXsgTargetLanguageNormalized Condition="'$(WpfXsgTargetLanguage)' == 'CSharp'">CSharp</WpfXsgTargetLanguageNormalized>
    <WpfXsgTargetLanguageNormalized Condition="'$(WpfXsgTargetLanguage)' == 'VB'">VisualBasic</WpfXsgTargetLanguageNormalized>
    <WpfXsgTargetLanguageNormalized Condition="'$(WpfXsgTargetLanguage)' == 'VisualBasic'">VisualBasic</WpfXsgTargetLanguageNormalized>
    <WpfXsgTargetLanguageNormalized Condition="'$(WpfXsgTargetLanguage)' == 'F#'">FSharp</WpfXsgTargetLanguageNormalized>
    <WpfXsgTargetLanguageNormalized Condition="'$(WpfXsgTargetLanguage)' == 'FSharp'">FSharp</WpfXsgTargetLanguageNormalized>
    <WpfXsgTargetLanguageNormalized Condition="'$(WpfXsgTargetLanguageNormalized)' == ''">CSharp</WpfXsgTargetLanguageNormalized>

    <!-- $(Language) is set by Microsoft.CSharp.targets which is imported via SDK.targets — after
         this file. Fall back to $(MSBuildProjectExtension) which is always available. -->
    <WpfXsgCSharpMode Condition="'$(WpfXsgTargetLanguageNormalized)' == 'CSharp' and ('$(Language)' == 'C#' or '$(MSBuildProjectExtension)' == '.csproj')">true</WpfXsgCSharpMode>
    <WpfXsgVisualBasicMode Condition="'$(WpfXsgTargetLanguageNormalized)' == 'VisualBasic' and ('$(Language)' == 'VB' or '$(MSBuildProjectExtension)' == '.vbproj')">true</WpfXsgVisualBasicMode>
    <WpfXsgFSharpMode Condition="'$(WpfXsgTargetLanguageNormalized)' == 'FSharp' and ('$(Language)' == 'F#' or '$(MSBuildProjectExtension)' == '.fsproj')">true</WpfXsgFSharpMode>

    <WpfXsgLanguageSupported Condition="'$(WpfXsgLanguageSupported)' == '' and ('$(WpfXsgCSharpMode)' == 'true' or '$(WpfXsgVisualBasicMode)' == 'true' or '$(WpfXsgFSharpMode)' == 'true')">true</WpfXsgLanguageSupported>
    <WpfXsgLanguageSupported Condition="'$(WpfXsgLanguageSupported)' == ''">false</WpfXsgLanguageSupported>

    <XamlSourceGenEnabled Condition="'$(XamlSourceGenEnabled)' == '' and '$(WpfXsgEnabled)' == 'true' and '$(WpfXsgLanguageSupported)' == 'true' and '$(WpfXsgFSharpMode)' != 'true'">true</XamlSourceGenEnabled>
    <XamlSourceGenEnabled Condition="'$(XamlSourceGenEnabled)' == ''">false</XamlSourceGenEnabled>

    <!--
      Auto-configure the `local` xmlns prefix from RootNamespace so XAML files do not
      need an explicit xmlns:local="clr-namespace:..." declaration (MAUI-style simpler XAML).
      Placed in .targets (not .props) so RootNamespace is already set from project content.
    -->
    <AvaloniaSourceGenGlobalXmlnsPrefixes
      Condition="'$(AvaloniaSourceGenGlobalXmlnsPrefixes)' == '' and '$(RootNamespace)' != '' and '$(WpfXsgEnabled)' == 'true' and '$(WpfXsgLanguageSupported)' == 'true'"
      >local=clr-namespace:$(RootNamespace)</AvaloniaSourceGenGlobalXmlnsPrefixes>

    <AvaloniaSourceGenImplicitProjectNamespacesEnabled
      Condition="'$(AvaloniaSourceGenImplicitProjectNamespacesEnabled)' == '' and '$(WpfXsgVisualBasicMode)' == 'true'"
      >true</AvaloniaSourceGenImplicitProjectNamespacesEnabled>

    <!--
      VB WPF templates commonly use unqualified x:Class values (for example "MainWindow").
      Enable path/root-namespace class inference so AXSG can map those to
      $(RootNamespace).<FileName> and bind the existing partial class.
    -->
    <AvaloniaSourceGenInferClassFromPath
      Condition="'$(AvaloniaSourceGenInferClassFromPath)' == '' and '$(WpfXsgVisualBasicMode)' == 'true'"
      >true</AvaloniaSourceGenInferClassFromPath>
  </PropertyGroup>

  <!--
    Make MSBuild properties and per-file item metadata visible to Roslyn source generators
    via the generated .editorconfig file. These are in .targets (not .props) so WpfXsgEnabled
    is already evaluated from the project file before this condition is checked.
  -->
  <ItemGroup Condition="'$(WpfXsgEnabled)' == 'true' and '$(WpfXsgLanguageSupported)' == 'true'">
    <!-- Per-file metadata: generator reads SourceItemGroup (Page/ApplicationDefinition)
         and TargetPath (for pack URI computation) from each AdditionalFiles entry. -->
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="SourceItemGroup" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="TargetPath" />

    <!-- Global properties the generator reads at file-independent level. -->
    <CompilerVisibleProperty Include="XamlSourceGenEnabled" />
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="AvaloniaSourceGenGlobalXmlnsPrefixes" />
    <CompilerVisibleProperty Include="AvaloniaSourceGenInferClassFromPath" />
    <CompilerVisibleProperty Include="WpfXsgTargetLanguage" />
    <CompilerVisibleProperty Include="WpfXsgAppendPoweredBy" />
  </ItemGroup>

  <!--
    WXSG (WPF XAML Source Generator) — MSBuild targets.

    This file handles two responsibilities:
      1. Move XAML files from the WPF-native Page/ApplicationDefinition build actions
         to None, bypassing BAML compilation (MarkupCompilePass1/2) entirely.
      2. Inject those files into AdditionalFiles (with SourceItemGroup/TargetPath metadata)
         BEFORE the Roslyn editorconfig snapshot is taken, so the generator sees them.

    Both actions are combined in a single target to guarantee they run atomically and
    only once.  BeforeTargets runs the target before whichever listed target executes
    first; MSBuild skips subsequent attempts after the first run.
  -->
  <!--
    Belt-and-suspenders LangVersion guard: set LangVersion >= 9.0 inside a target so it
    runs AFTER all property evaluation (including the SDK's implicit Sdk.targets, which can
    cap .NETFramework projects at C# 7.3 even after the PropertyGroup above set it to 9.0).
  -->
  <Target Name="_WxsgEnsureLangVersion9"
          BeforeTargets="CoreCompile"
          Condition="'$(WpfXsgEnabled)' == 'true' and '$(Language)' == 'C#'">
    <Message Importance="High"
             Text="[WXSG_DEBUG] _WxsgEnsureLangVersion9: LangVersion=$(LangVersion) Language=$(Language) CSharpMode=$(WpfXsgCSharpMode) LanguageSupported=$(WpfXsgLanguageSupported)"
             Condition="'$(WXSG_DEBUG)' != ''" />
    <PropertyGroup>
      <LangVersion Condition="'$(LangVersion)' == '' or '$(LangVersion)' == '7' or '$(LangVersion)' == '7.0' or '$(LangVersion)' == '7.1' or '$(LangVersion)' == '7.2' or '$(LangVersion)' == '7.3' or '$(LangVersion)' == '8' or '$(LangVersion)' == '8.0'">9.0</LangVersion>
      <!--
        Expose WXSG_ENABLED as a compile constant so user code can use #if WXSG_ENABLED
        to guard any WXSG-specific sections without a hard project-file dependency.
        Setting this in a target (not a PropertyGroup) guarantees it runs after the SDK
        sets its own DefineConstants so our value is appended, not lost.
      -->
      <DefineConstants>$(DefineConstants);WXSG_ENABLED</DefineConstants>
    </PropertyGroup>
  </Target>

  <Target Name="_WxsgPrepareXamlCSharp"
          BeforeTargets="MarkupCompilePass1;GenerateMSBuildEditorConfigFileShouldRun"
      Condition="'$(WpfXsgEnabled)' == 'true' and '$(WpfXsgCSharpMode)' == 'true'">

    <Message Importance="High"
             Text="[WXSG_DEBUG] _WxsgPrepareXamlCSharp: project=$(MSBuildProjectName) tfm=$(TargetFramework) lang=$(Language) ext=$(MSBuildProjectExtension) CSharpMode=$(WpfXsgCSharpMode)"
             Condition="'$(WXSG_DEBUG)' != ''" />

    <!--
      Remove stale BAML files for CLASSED pages only (those moved out of Page below).
      We KEEP classless pages in Page so MarkupCompilePass1 produces fresh BAML for them.
    -->
    <ItemGroup>
      <_WxsgClassedPage Include="@(Page)"
        Condition="'%(FullPath)' != '' and $([System.IO.File]::Exists('%(FullPath)')) and $([System.IO.File]::ReadAllText('%(FullPath)').Contains('x:Class'))" />
      <_WxsgClasslessPage Include="@(Page)"
        Condition="'%(FullPath)' != '' and $([System.IO.File]::Exists('%(FullPath)')) and !$([System.IO.File]::ReadAllText('%(FullPath)').Contains('x:Class'))" />
    </ItemGroup>

    <!-- Capture as a property so it can be used safely in per-item batching conditions below. -->
    <PropertyGroup>
      <_WxsgHasClassedPages Condition="'@(_WxsgClassedPage)' != ''">true</_WxsgHasClassedPages>
      <_WxsgHasClassedPages Condition="'$(_WxsgHasClassedPages)' == ''">false</_WxsgHasClassedPages>
    </PropertyGroup>

    <Message Importance="High"
             Text="[WXSG_DEBUG] _WxsgPrepareXamlCSharp: classed-pages=@(_WxsgClassedPage) classless-pages=@(_WxsgClasslessPage) has-classed=$(_WxsgHasClassedPages)"
             Condition="'$(WXSG_DEBUG)' != ''" />

    <Delete Files="@(_WxsgClassedPage -> '$(IntermediateOutputPath)%(RelativeDir)%(Filename).baml')"
            ContinueOnError="true" />
    <Delete Files="@(ApplicationDefinition -> '$(IntermediateOutputPath)%(RelativeDir)%(Filename).baml')"
            ContinueOnError="true" />

    <ItemGroup>
      <!--
        Page items are split into classed (x:Class present) and classless (ResourceDictionaries).

        CLASSED XAML files: WXSG replaces InitializeComponent() codegen for these. They are moved
        out of Page so MarkupCompilePass1 does not produce conflicting .g.cs files alongside
        WXSG's source-generated output. This must run in both the main project and any
        _wpftmp temporary project so WXSG-generated partial classes remain available anywhere
        WPF compiles code-behind.

        CLASSLESS XAML files (theme dictionaries such as Themes/generic.xaml): These have no
        x:Class and no code-behind, so the _wpftmp issue does not apply. We KEEP them in Page
        so MarkupCompilePass1 compiles them to BAML. This is critical because WPF's
        SystemResources.FindThemeStyle (used for DefaultStyleKey lookups via [ThemeInfo]) only
        finds theme styles in BAML embedded under "Themes/<theme>.xaml" — Application.Resources
        is NOT consulted for that path. Without BAML, controls that override DefaultStyleKey
        (e.g. AvalonDock's LayoutGridResizerControl) would receive no template even though we
        also merge the dictionary into Application.Resources via __WxsgThemeLoader.

        We still feed classless pages to the source generator as AdditionalFiles so
        __WxsgThemeLoader can also merge them into Application.Resources (which makes
        TryFindResource and implicit-style lookups work for the same keys).
      -->
    </ItemGroup>

    <ItemGroup>
      <!-- Feed classed XAML into Roslyn as AdditionalFiles so the source generator sees them. -->
      <AdditionalFiles Include="@(_WxsgClassedPage)">
        <SourceItemGroup>Page</SourceItemGroup>
        <TargetPath>%(_WxsgClassedPage.RecursiveDir)%(_WxsgClassedPage.Filename)%(_WxsgClassedPage.Extension)</TargetPath>
      </AdditionalFiles>

      <AdditionalFiles Include="@(ApplicationDefinition)">
        <SourceItemGroup>ApplicationDefinition</SourceItemGroup>
        <TargetPath>%(ApplicationDefinition.RecursiveDir)%(ApplicationDefinition.Filename)%(ApplicationDefinition.Extension)</TargetPath>
      </AdditionalFiles>

      <!--
        Feed classless XAML into Roslyn as AdditionalFiles with SourceItemGroup=ClasslessPage.
        The source generator emits __WxsgThemeLoader to merge them into Application.Resources
        at runtime — for explicit TryFindResource and implicit-style scenarios.
      -->
      <AdditionalFiles Include="@(_WxsgClasslessPage)">
        <SourceItemGroup>ClasslessPage</SourceItemGroup>
        <TargetPath>%(_WxsgClasslessPage.RelativeDir)%(_WxsgClasslessPage.Filename)%(_WxsgClasslessPage.Extension)</TargetPath>
      </AdditionalFiles>

      <!--
        Remove only CLASSED pages from the Page build action.  Classless pages stay in Page
        so MarkupCompilePass1 produces BAML for them (required by WPF's ThemeInfo lookup).
      -->
      <None Include="@(_WxsgClassedPage)" />
      <Page Remove="@(_WxsgClassedPage)" />

      <None Include="@(ApplicationDefinition)" />
      <ApplicationDefinition Remove="@(ApplicationDefinition)" />

      <!--
        Embed classed XAML as Resource items so pack://application:,,,/ URIs resolve
        at runtime for Application.LoadComponent in WXSG-generated InitializeComponent.
        Classless XAML does NOT need this — it stays in Page above and is embedded as BAML.
      -->
      <Resource Include="@(_WxsgClassedPage)" KeepDuplicates="false" />

      <!--
        BAML bypass: in projects that contain any classed XAML, defer ALL classless pages
        to post-CoreCompile BAML generation. WPF's Pass1-to-Pass2 deferral heuristics are
        broader than a simple local-type text scan and can still route seemingly harmless
        classless dictionaries into _wpftmp (for example SharpDevelop's ColumnPicker.xaml).

        Once _wpftmp is invoked, the temporary compilation contains user code-behind but not
        the WXSG-generated partial classes for classed XAML, leading to missing
        InitializeComponent, named fields, and classed ResourceDictionary types.

        For pure resource-dictionary projects (no x:Class pages), _wpftmp does not create
        that mismatch, so classless pages stay on @(Page).
      -->
      <_WxsgDeferredClasslessPage Include="@(_WxsgClasslessPage)"
        Condition="'$(_WxsgHasClassedPages)' == 'true' and '%(FullPath)' != '' and $([System.IO.File]::Exists('%(FullPath)'))" />

      <Page Remove="@(_WxsgDeferredClasslessPage)" />
      <None Include="@(_WxsgDeferredClasslessPage)" />
    </ItemGroup>

    <!--
      Generate normalized raw XAML copies for diagnostics and regression coverage.
      Runtime loading should prefer the injected BAML entries from _WxsgBamlBypass;
      embedding these raw copies under the same pack URI would shadow the BAML and
      make WPF parse dictionaries that may contain internal same-assembly types.
      WxsgStripXSharedFromXaml strips x:Shared, a BAML-only attribute rejected by
      the raw XAML parser, and assembly-qualifies same-assembly x:Static member
      tokens without changing the xmlns values used for element/type creation.
    -->
    <WxsgStripXSharedFromXaml
        InputFiles="@(_WxsgDeferredClasslessPage)"
        OutputDirectory="$(IntermediateOutputPath)wxsg\raw-deferred"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        AssemblyName="$(AssemblyName)"
        Condition="'@(_WxsgDeferredClasslessPage)' != ''">
      <Output TaskParameter="StrippedFiles" ItemName="_WxsgEmbeddedDeferredClasslessPage" />
    </WxsgStripXSharedFromXaml>

    <Message Importance="Low"
             Text="WXSG: deferring classless page to post-CoreCompile BAML: %(_WxsgDeferredClasslessPage.Identity)" />
    <Message Importance="High"
             Text="[WXSG_DEBUG] _WxsgPrepareXamlCSharp: deferred-classless=@(_WxsgDeferredClasslessPage)"
             Condition="'$(WXSG_DEBUG)' != ''" />
  </Target>

  <Target Name="_WxsgPrepareXamlVisualBasic"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun"
      Condition="'$(WpfXsgEnabled)' == 'true' and '$(WpfXsgVisualBasicMode)' == 'true'">
    <ItemGroup>
      <AdditionalFiles Include="@(Page)">
        <SourceItemGroup>Page</SourceItemGroup>
        <TargetPath>%(Page.RecursiveDir)%(Page.Filename)%(Page.Extension)</TargetPath>
      </AdditionalFiles>

      <AdditionalFiles Include="@(ApplicationDefinition)">
        <SourceItemGroup>ApplicationDefinition</SourceItemGroup>
        <TargetPath>%(ApplicationDefinition.RecursiveDir)%(ApplicationDefinition.Filename)%(ApplicationDefinition.Extension)</TargetPath>
      </AdditionalFiles>
    </ItemGroup>
  </Target>

  <!--
    Inline MSBuild task: preprocesses each classless XAML file before it is embedded
    as a raw resource.

    Strip x:Shared attributes — valid only in compiled BAML; the raw-XAML parser
    (used when WPF loads pack:// resources that are not BAML) rejects them with
    "Shared attribute can be used only in compiled resource dictionaries."

    Do not add assembly=$(AssemblyName) to bare same-assembly clr-namespace values.
    WPF can instantiate internal same-assembly types from raw XAML only when the
    namespace remains local; forcing an explicit assembly makes those types look
    external and can fail with "Cannot create unknown type".

    Same-assembly x:Static member tokens are different: WPF's raw StaticExtension
    does not infer the current assembly from a bare clr-namespace prefix, so rewrite
    only those tokens to a clr-namespace:...;assembly=... member reference while
    leaving the xmlns declaration itself unchanged.

    The Link metadata is set so MSBuild embeds the processed copy under the same
    pack URI path as the original.
  -->
  <UsingTask TaskName="WxsgStripXSharedFromXaml"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <InputFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <ProjectDirectory ParameterType="System.String" Required="true" />
      <AssemblyName ParameterType="System.String" Required="false" />
      <StrippedFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Using Namespace="Microsoft.Build.Utilities" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var result = new List<ITaskItem>();
        Directory.CreateDirectory(OutputDirectory);
        foreach (var inputFile in InputFiles)
        {
            try
            {
                var fullPath = inputFile.GetMetadata("FullPath");
                if (string.IsNullOrEmpty(fullPath)) fullPath = inputFile.ItemSpec;
                var content = File.ReadAllText(fullPath, Encoding.UTF8);

                // 1. Strip x:Shared (BAML-only attribute).
                var processed = Regex.Replace(
                    content,
                    @"[ \t]*x:Shared\s*=\s*""[^""]*""",
                    string.Empty,
                    RegexOptions.IgnoreCase);

                // 2. For bare same-assembly xmlns declarations, qualify only x:Static
                //    member tokens. Leave xmlns values bare so internal same-assembly
                //    elements can still be created by WPF's raw XAML loader.
                if (!string.IsNullOrEmpty(AssemblyName))
                {
                    var localClrNamespacesByPrefix = new Dictionary<string, string>(StringComparer.Ordinal);
                    foreach (Match match in Regex.Matches(
                        processed,
                        @"xmlns:(?<prefix>[A-Za-z_][\w.-]*)\s*=\s*[""']clr-namespace:(?<namespace>[^;""']+)[""']",
                        RegexOptions.IgnoreCase))
                    {
                        var prefix = match.Groups["prefix"].Value;
                        var clrNamespace = match.Groups["namespace"].Value;
                        if (!string.IsNullOrWhiteSpace(prefix) &&
                            !string.IsNullOrWhiteSpace(clrNamespace) &&
                            !localClrNamespacesByPrefix.ContainsKey(prefix))
                        {
                            localClrNamespacesByPrefix.Add(prefix, clrNamespace);
                        }
                    }

                    // For raw XAML parsing, we cannot inline a full "clr-namespace:...;assembly=...:Type.Member"
                    // inside the markup extension value — the WPF XAML parser rejects that syntax.
                    // Instead, add a new xmlns prefix that includes the assembly and rewrite
                    // the {x:Static prefix:...} occurrences to use the new prefix. This preserves
                    // the original xmlns declarations (which may be intentionally bare to allow
                    // same-assembly internal types), and provides an assembly-qualified alias
                    // only for the static member usages that need it.
                    var prefixCounter = 0;
                    // Find the start tag of the root element so we can inject new xmlns declarations.
                    var rootMatch = Regex.Match(processed, @"<\s*(?<name>[A-Za-z_][\w\.\-]*)(?<attrs>[^>]*)>", RegexOptions.IgnoreCase);
                    for (var mappingEnum = localClrNamespacesByPrefix.GetEnumerator(); mappingEnum.MoveNext();) {
                      var mapping = mappingEnum.Current;
                      var existingPrefix = mapping.Key;
                      var clrNamespace = mapping.Value;

                      // Generate a unique temporary prefix that is unlikely to collide with user prefixes.
                      string newPrefix;
                      do {
                        newPrefix = "wxsg_asm" + prefixCounter++;
                      } while (processed.IndexOf("xmlns:" + newPrefix + "=", StringComparison.OrdinalIgnoreCase) >= 0);

                      // Inject the new xmlns declaration into the root start tag, if found.
                      if (rootMatch.Success)
                      {
                        var xmlnsDecl = " xmlns:" + newPrefix + "=\"clr-namespace:" + clrNamespace + ";assembly=" + AssemblyName + "\"";
                        var originalStart = rootMatch.Value;
                        var injectedStart = "<" + rootMatch.Groups["name"].Value + rootMatch.Groups["attrs"].Value + xmlnsDecl + ">";
                        processed = processed.Substring(0, rootMatch.Index) + injectedStart + processed.Substring(rootMatch.Index + originalStart.Length);
                        // Update rootMatch so subsequent injections don't use stale indices.
                        rootMatch = Regex.Match(processed, @"<\s*(?<name>[A-Za-z_][\w\.\-]*)(?<attrs>[^>]*)>", RegexOptions.IgnoreCase);
                      }

                      // Replace usages of the original prefix in x:Static markup extensions with the new prefix.
                      var pattern = @"\{x:Static\s+" + Regex.Escape(existingPrefix) + @":";
                      var replacement = "{x:Static " + newPrefix + ":";
                      processed = Regex.Replace(processed, pattern, _ => replacement, RegexOptions.IgnoreCase);
                    }
                }

                // Determine the link path (relative to project dir) so the embedded
                // resource gets the same name as the original file.
                var linkPath = inputFile.GetMetadata("Link");
                if (string.IsNullOrEmpty(linkPath))
                {
                    // Compute relative path from project dir
                    var proj = ProjectDirectory.TrimEnd(Path.DirectorySeparatorChar,
                                                        Path.AltDirectorySeparatorChar)
                                               + Path.DirectorySeparatorChar;
                    linkPath = fullPath.StartsWith(proj, StringComparison.OrdinalIgnoreCase)
                        ? fullPath.Substring(proj.Length)
                        : Path.GetFileName(fullPath);
                }

                var outPath = Path.Combine(OutputDirectory, linkPath);
                Directory.CreateDirectory(Path.GetDirectoryName(outPath));
                File.WriteAllText(outPath, processed, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));

                var outItem = new TaskItem(outPath);
                inputFile.CopyMetadataTo(outItem);
                outItem.SetMetadata("Link", linkPath);
                result.Add(outItem);
            }
            catch (Exception ex)
            {
                Log.LogWarning("WxsgStripXShared: failed to process '{0}': {1}",
                               inputFile.ItemSpec, ex.Message);
            }
        }
        StrippedFiles = result.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Normalize classless XAML for BAML: remove assembly=$(AssemblyName) from
       clr-namespace values that reference the current assembly, and strip
       x:Shared attributes. This helps MarkupCompilePass1 resolve same-assembly
       types even when XAML files include an explicit assembly= reference. -->
  <UsingTask TaskName="WxsgNormalizeXamlForBaml"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <InputFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <ProjectDirectory ParameterType="System.String" Required="true" />
      <AssemblyName ParameterType="System.String" Required="false" />
      <NormalizedFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Using Namespace="Microsoft.Build.Utilities" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var result = new List<ITaskItem>();
        Directory.CreateDirectory(OutputDirectory);
        foreach (var inputFile in InputFiles)
        {
            try
            {
                var fullPath = inputFile.GetMetadata("FullPath");
                if (string.IsNullOrEmpty(fullPath)) fullPath = inputFile.ItemSpec;
                var content = File.ReadAllText(fullPath, Encoding.UTF8);

                // 1. Strip x:Shared (BAML-only attribute).
                var processed = Regex.Replace(
                  content,
                  @"[ \t]*x:Shared\s*=\s*""[^""]*""",
                  string.Empty,
                  RegexOptions.IgnoreCase);

                // 2. Remove assembly=$(AssemblyName) when present on clr-namespace: values
                //    so the compiler treats the xmlns as same-assembly. This avoids
                //    MC3xxx errors when the XAML explicitly names the current assembly.
                if (!string.IsNullOrEmpty(AssemblyName))
                {
                    var pattern = @"(clr-namespace:[^;""']+)\s*;\s*assembly\s*=\s*" + Regex.Escape(AssemblyName);
                    processed = Regex.Replace(processed, pattern, "$1", RegexOptions.IgnoreCase);
                }

                // Determine the link path (relative to project dir) so the embedded
                // resource gets the same name as the original file.
                var linkPath = inputFile.GetMetadata("Link");
                if (string.IsNullOrEmpty(linkPath))
                {
                    var proj = ProjectDirectory.TrimEnd(Path.DirectorySeparatorChar,
                                                        Path.AltDirectorySeparatorChar)
                                               + Path.DirectorySeparatorChar;
                    linkPath = fullPath.StartsWith(proj, StringComparison.OrdinalIgnoreCase)
                        ? fullPath.Substring(proj.Length)
                        : Path.GetFileName(fullPath);
                }

                var outPath = Path.Combine(OutputDirectory, linkPath);
                Directory.CreateDirectory(Path.GetDirectoryName(outPath));
                File.WriteAllText(outPath, processed, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));

                var outItem = new TaskItem(outPath);
                inputFile.CopyMetadataTo(outItem);
                outItem.SetMetadata("Link", linkPath);
                result.Add(outItem);
            }
            catch (Exception ex)
            {
                Log.LogWarning("WxsgNormalizeXamlForBaml: failed to process '{0}': {1}", inputFile.ItemSpec, ex.Message);
            }
        }
        NormalizedFiles = result.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

    <!-- Preprocess classless Page XAML (themes/resource dictionaries) before
         MarkupCompilePass1 so the WPF XAML compiler can resolve same-assembly
         clr-namespace declarations and BAML generation succeeds without
         modifying upstream source files. This uses the inline WxsgNormalizeXamlForBaml
         task to strip x:Shared and remove assembly=$(AssemblyName) from
         "clr-namespace:...;assembly=X" xmlns values. -->
    <Target Name="_WxsgPreprocessClasslessXaml"
            BeforeTargets="MarkupCompilePass1"
            Condition="'$(WpfXsgEnabled)' == 'true' and !$(MSBuildProjectName.Contains('_wpftmp'))">

      <!-- Select Page items that do NOT contain x:Class (classless/theme dictionaries). -->
      <ItemGroup>
        <_WxsgClasslessToProcess Include="@(Page)"
          Condition="'%(FullPath)' != '' and $([System.IO.File]::Exists('%(FullPath)')) and !$([System.IO.File]::ReadAllText('%(FullPath)').Contains('x:Class'))" />
      </ItemGroup>

      <!--
        Only normalize files whose content would actually change: those containing
        x:Shared (a BAML-only attribute the raw XAML parser rejects) or an explicit
        assembly=$(AssemblyName) qualifier on a clr-namespace: URI (which MarkupCompile
        rejects because it conflicts with the implicit local-assembly context).

        Files that need no change are left as their ORIGINAL Page items.  Replacing an
        unchanged file with an identical copy would still break the MarkupCompile
        incremental cache (path mismatch) and trigger the stricter MarkupCompilePass2
        type-resolution path.  Pass2 is more strict than Pass1: it reports MC3050 as
        a hard error for any unresolvable type, including forward-references to types
        from sibling assemblies embedded in a classless ResourceDictionary that WPF
        accepts at runtime via late-bound BAML loading.
      -->
      <ItemGroup>
        <_WxsgClasslessNeedingNorm Include="@(_WxsgClasslessToProcess)"
          Condition="'%(FullPath)' != '' and (
            $([System.IO.File]::ReadAllText('%(FullPath)').Contains('x:Shared')) or
            $([System.IO.File]::ReadAllText('%(FullPath)').Contains('assembly=$(AssemblyName)'))
          )" />
        <_WxsgClasslessUnchanged Include="@(_WxsgClasslessToProcess)"
          Condition="'%(FullPath)' != '' and
            !$([System.IO.File]::ReadAllText('%(FullPath)').Contains('x:Shared')) and
            !$([System.IO.File]::ReadAllText('%(FullPath)').Contains('assembly=$(AssemblyName)'))
          " />
      </ItemGroup>

      <Message Importance="Low" Text="WXSG: normalizing classless XAML (x:Shared or assembly= present): %(_WxsgClasslessNeedingNorm.Identity)" />
      <Message Importance="Low" Text="WXSG: skipping classless XAML normalization (no changes needed): %(_WxsgClasslessUnchanged.Identity)" />

      <WxsgNormalizeXamlForBaml InputFiles="@(_WxsgClasslessNeedingNorm)"
                                 OutputDirectory="$(IntermediateOutputPath)wxsg\stripped"
                                 ProjectDirectory="$(MSBuildProjectDirectory)"
                                 AssemblyName="$(AssemblyName)">
        <Output TaskParameter="NormalizedFiles" ItemName="_WxsgStrippedClassless" />
      </WxsgNormalizeXamlForBaml>

      <!-- Replace only files that actually needed normalization with their processed
           copies.  Files in _WxsgClasslessUnchanged keep their original Page entry. -->
      <ItemGroup>
        <Page Remove="@(_WxsgClasslessNeedingNorm)" />
        <Page Include="@(_WxsgStrippedClassless)" />
      </ItemGroup>
    </Target>

  <UsingTask TaskName="WxsgGenerateFSharpCode"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <XamlFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <GeneratedFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml.Linq" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Using Namespace="Microsoft.Build.Utilities" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Mapping of common XAML element local names to fully-qualified WPF types.
        var wpfTypeMap = new Dictionary<string, string>(StringComparer.Ordinal)
        {
          // System.Windows
          { "Window",            "System.Windows.Window" },
          { "UserControl",       "System.Windows.Controls.UserControl" },
          { "Page",              "System.Windows.Controls.Page" },
          // Layout
          { "Grid",              "System.Windows.Controls.Grid" },
          { "StackPanel",        "System.Windows.Controls.StackPanel" },
          { "DockPanel",         "System.Windows.Controls.DockPanel" },
          { "WrapPanel",         "System.Windows.Controls.WrapPanel" },
          { "Canvas",            "System.Windows.Controls.Canvas" },
          { "UniformGrid",       "System.Windows.Controls.Primitives.UniformGrid" },
          { "ScrollViewer",      "System.Windows.Controls.ScrollViewer" },
          { "Border",            "System.Windows.Controls.Border" },
          { "Viewbox",           "System.Windows.Controls.Viewbox" },
          { "GroupBox",          "System.Windows.Controls.GroupBox" },
          { "Expander",          "System.Windows.Controls.Expander" },
          { "TabControl",        "System.Windows.Controls.TabControl" },
          { "TabItem",           "System.Windows.Controls.TabItem" },
          { "GridSplitter",      "System.Windows.Controls.GridSplitter" },
          // Content controls
          { "Button",            "System.Windows.Controls.Button" },
          { "ToggleButton",      "System.Windows.Controls.Primitives.ToggleButton" },
          { "CheckBox",          "System.Windows.Controls.CheckBox" },
          { "RadioButton",       "System.Windows.Controls.RadioButton" },
          { "Label",             "System.Windows.Controls.Label" },
          { "TextBlock",         "System.Windows.Controls.TextBlock" },
          { "TextBox",           "System.Windows.Controls.TextBox" },
          { "PasswordBox",       "System.Windows.Controls.PasswordBox" },
          { "RichTextBox",       "System.Windows.Controls.RichTextBox" },
          { "ComboBox",          "System.Windows.Controls.ComboBox" },
          { "ComboBoxItem",      "System.Windows.Controls.ComboBoxItem" },
          { "ListBox",           "System.Windows.Controls.ListBox" },
          { "ListBoxItem",       "System.Windows.Controls.ListBoxItem" },
          { "ListView",          "System.Windows.Controls.ListView" },
          { "TreeView",          "System.Windows.Controls.TreeView" },
          { "TreeViewItem",      "System.Windows.Controls.TreeViewItem" },
          { "DataGrid",          "System.Windows.Controls.DataGrid" },
          { "DataGridColumn",    "System.Windows.Controls.DataGridColumn" },
          { "Slider",            "System.Windows.Controls.Slider" },
          { "ProgressBar",       "System.Windows.Controls.ProgressBar" },
          { "ScrollBar",         "System.Windows.Controls.Primitives.ScrollBar" },
          { "Image",             "System.Windows.Controls.Image" },
          { "MediaElement",      "System.Windows.Controls.MediaElement" },
          { "WebBrowser",        "System.Windows.Controls.WebBrowser" },
          { "Frame",             "System.Windows.Controls.Frame" },
          // Menus / toolbars
          { "Menu",              "System.Windows.Controls.Menu" },
          { "MenuItem",          "System.Windows.Controls.MenuItem" },
          { "ContextMenu",       "System.Windows.Controls.ContextMenu" },
          { "ToolBar",           "System.Windows.Controls.ToolBar" },
          { "ToolBarTray",       "System.Windows.Controls.ToolBarTray" },
          { "StatusBar",         "System.Windows.Controls.Primitives.StatusBar" },
          { "StatusBarItem",     "System.Windows.Controls.Primitives.StatusBarItem" },
          { "Separator",         "System.Windows.Controls.Separator" },
          // Shapes
          { "Rectangle",         "System.Windows.Shapes.Rectangle" },
          { "Ellipse",           "System.Windows.Shapes.Ellipse" },
          { "Line",              "System.Windows.Shapes.Line" },
          { "Path",              "System.Windows.Shapes.Path" },
          { "Polygon",           "System.Windows.Shapes.Polygon" },
          { "Polyline",          "System.Windows.Shapes.Polyline" },
        };

        var generated = new List<ITaskItem>();
        Directory.CreateDirectory(OutputDirectory);

        XNamespace xamlNs = "http://schemas.microsoft.com/winfx/2006/xaml";

        foreach (var xamlFile in XamlFiles ?? Array.Empty<ITaskItem>())
        {
          var filePath = xamlFile.GetMetadata("FullPath");
          if (string.IsNullOrWhiteSpace(filePath))
          {
            filePath = xamlFile.ItemSpec;
          }

          if (string.IsNullOrWhiteSpace(filePath) || !File.Exists(filePath))
          {
            continue;
          }

          var targetPath = xamlFile.GetMetadata("TargetPath");
          if (string.IsNullOrWhiteSpace(targetPath))
          {
            targetPath = Path.GetFileName(filePath);
          }
          targetPath = targetPath.Replace('\\', '/');

          XDocument xdoc;
          try
          {
            xdoc = XDocument.Load(filePath, LoadOptions.SetLineInfo);
          }
          catch
          {
            continue;
          }

          var root = xdoc.Root;
          if (root == null)
          {
            continue;
          }

          var classAttr = root.Attribute(xamlNs + "Class");
          var classFullName = classAttr?.Value?.Trim();
          if (string.IsNullOrWhiteSpace(classFullName))
          {
            continue;
          }

          var lastDot = classFullName.LastIndexOf('.');
          if (lastDot <= 0 || lastDot >= classFullName.Length - 1)
          {
            continue;
          }

          var classNamespace = classFullName.Substring(0, lastDot);
          var className = classFullName.Substring(lastDot + 1);
          var escapedTargetPath = targetPath.Replace("\"", "\"\"");
          var rootLocalName = root.Name.LocalName;
          var baseTypeName = "System.Windows.FrameworkElement";
          if (string.Equals(rootLocalName, "Window", StringComparison.Ordinal))
          {
            baseTypeName = "System.Windows.Window";
          }
          else if (string.Equals(rootLocalName, "Application", StringComparison.Ordinal))
          {
            baseTypeName = "System.Windows.Application";
          }

          // Collect all elements with x:Name (skip the root itself).
          var namedElements = new List<KeyValuePair<string, string>>(); // (fieldName, wpfType)
          foreach (var el in root.Descendants())
          {
            var nameAttr = el.Attribute(xamlNs + "Name");
            var fieldName = nameAttr?.Value?.Trim();
            if (string.IsNullOrWhiteSpace(fieldName))
            {
              continue;
            }

            string wpfType;
            if (!wpfTypeMap.TryGetValue(el.Name.LocalName, out wpfType))
            {
              wpfType = "System.Windows.FrameworkElement";
            }

            namedElements.Add(new KeyValuePair<string, string>(fieldName, wpfType));
          }

          var outputFile = Path.Combine(
            OutputDirectory,
            classFullName.Replace('.', '_').Replace('+', '_') + ".wxsg.g.fs");

          var sb = new StringBuilder(1024);
          sb.AppendLine("// <auto-generated/>");
          sb.AppendLine("namespace " + classNamespace);
          sb.AppendLine();
          sb.AppendLine("open System");
          sb.AppendLine("open System.IO");
          sb.AppendLine("open System.Windows");
          sb.AppendLine("open System.Windows.Markup");
          sb.AppendLine("open System.Xml.Linq");
          sb.AppendLine();
          sb.AppendLine("type " + className + "() as this =");
          sb.AppendLine("    inherit " + baseTypeName + "()");
          sb.AppendLine("    let mutable _contentLoaded = false");

          // Emit a let mutable field for each named element.
          // Use __ prefix on the private binding to avoid the FS0905 clash with the
          // same-named public member property emitted below.
          foreach (var named in namedElements)
          {
            sb.AppendLine("    let mutable __" + named.Key + " : " + named.Value + " = Unchecked.defaultof<_>");
          }

          sb.AppendLine("    do this.InitializeComponent()");
          sb.AppendLine();
          sb.AppendLine("    member this.InitializeComponent() =");
          sb.AppendLine("        if _contentLoaded then");
          sb.AppendLine("            ()");
          sb.AppendLine("        else");
          sb.AppendLine("            _contentLoaded <- true");
          sb.AppendLine("            let __xamlPath = Path.Combine(AppContext.BaseDirectory, \"" + escapedTargetPath + "\")");
          sb.AppendLine("            if File.Exists(__xamlPath) then");
          if (string.Equals(baseTypeName, "System.Windows.Window", StringComparison.Ordinal))
          {
            sb.AppendLine("                use __stream = File.OpenRead(__xamlPath)");
            sb.AppendLine("                let __loaded = XamlReader.Load(__stream) :?> Window");
            // Wire up named elements before moving content (NameScope lives on __loaded).
            foreach (var named in namedElements)
            {
              sb.AppendLine("                __" + named.Key + " <- __loaded.FindName(\"" + named.Key + "\") :?> " + named.Value);
            }
            sb.AppendLine("                this.Content <- __loaded.Content");
            sb.AppendLine("                this.Title <- __loaded.Title");
            sb.AppendLine("                this.Width <- __loaded.Width");
            sb.AppendLine("                this.Height <- __loaded.Height");
            sb.AppendLine("                this.Resources <- __loaded.Resources");
          }
          else if (string.Equals(baseTypeName, "System.Windows.Application", StringComparison.Ordinal))
          {
            // XamlReader.Load(Application.xaml) would create a second Application
            // instance, which WPF forbids (singleton).  Parse the XAML as plain XML
            // instead and extract the properties we need directly.
            sb.AppendLine("                let __xdoc = XDocument.Load(__xamlPath)");
            sb.AppendLine("                let __wpfNs = XNamespace.Get(\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\")");
            sb.AppendLine("                // StartupUri attribute on the root element");
            sb.AppendLine("                let __startupUriAttr = __xdoc.Root.Attribute(\"StartupUri\")");
            sb.AppendLine("                if not (isNull __startupUriAttr) && not (System.String.IsNullOrWhiteSpace(__startupUriAttr.Value)) then");
            sb.AppendLine("                    this.StartupUri <- System.Uri(__startupUriAttr.Value, System.UriKind.Relative)");
            sb.AppendLine("                // Application.Resources child element");
            sb.AppendLine("                let __resEl = __xdoc.Root.Element(__wpfNs + \"Application.Resources\")");
            sb.AppendLine("                if not (isNull __resEl) then");
            sb.AppendLine("                    for __child in __resEl.Elements() do");
            sb.AppendLine("                        let __rdXml = __child.ToString()");
            sb.AppendLine("                        let __rd = XamlReader.Parse(__rdXml) :?> System.Windows.ResourceDictionary");
            sb.AppendLine("                        this.Resources.MergedDictionaries.Add(__rd)");
          }
          else
          {
            sb.AppendLine("                use __stream = File.OpenRead(__xamlPath)");
            sb.AppendLine("                let __loaded = XamlReader.Load(__stream) :?> System.Windows.FrameworkElement");
            // Wire up named elements.
            foreach (var named in namedElements)
            {
              sb.AppendLine("                __" + named.Key + " <- __loaded.FindName(\"" + named.Key + "\") :?> " + named.Value);
            }
            sb.AppendLine("                ignore __loaded");
          }
          sb.AppendLine("            else");
          sb.AppendLine("                ()");

          // Expose named elements as read-only members accessible from outside the class.
          foreach (var named in namedElements)
          {
            sb.AppendLine("    member _.``" + named.Key + "`` = __" + named.Key);
          }

          File.WriteAllText(outputFile, sb.ToString(), Encoding.UTF8);
          var generatedItem = new TaskItem(outputFile);
          generatedItem.SetMetadata("AutoGen", "True");
          generatedItem.SetMetadata("DesignTime", "True");
          generatedItem.SetMetadata("Visible", "False");
          generated.Add(generatedItem);
        }

        GeneratedFiles = generated.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_WxsgPrepareXamlFSharp"
          BeforeTargets="MarkupCompilePass1;CoreCompile"
          Condition="'$(WpfXsgEnabled)' == 'true' and '$(WpfXsgFSharpMode)' == 'true' and !$(MSBuildProjectName.Contains('_wpftmp'))">
    <ItemGroup>
      <_WxsgFSharpXaml Include="@(Page)">
        <TargetPath>%(Page.RecursiveDir)%(Page.Filename)%(Page.Extension)</TargetPath>
      </_WxsgFSharpXaml>

      <_WxsgFSharpXaml Include="@(ApplicationDefinition)">
        <TargetPath>%(ApplicationDefinition.RecursiveDir)%(ApplicationDefinition.Filename)%(ApplicationDefinition.Extension)</TargetPath>
      </_WxsgFSharpXaml>

      <None Include="@(_WxsgFSharpXaml)" />
      <Page Remove="@(Page)" />
      <ApplicationDefinition Remove="@(ApplicationDefinition)" />

      <Content Include="@(_WxsgFSharpXaml)" KeepDuplicates="false">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>%(_WxsgFSharpXaml.TargetPath)</TargetPath>
      </Content>
    </ItemGroup>

    <MakeDir Directories="$(IntermediateOutputPath)wxsg\fsharp" />

    <WxsgGenerateFSharpCode XamlFiles="@(_WxsgFSharpXaml)"
                            OutputDirectory="$(IntermediateOutputPath)wxsg\fsharp">
      <Output TaskParameter="GeneratedFiles" ItemName="_WxsgGeneratedFSharpCompile" />
    </WxsgGenerateFSharpCode>

    <ItemGroup>
      <_WxsgUserCompile Include="@(Compile)" Exclude="@(_WxsgGeneratedFSharpCompile)" />
      <Compile Remove="@(Compile)" />
      <Compile Include="@(_WxsgGeneratedFSharpCompile)"
               AutoGen="True"
               DesignTime="True"
               Visible="False" />
      <Compile Include="@(_WxsgUserCompile)" />
    </ItemGroup>
  </Target>

  <Target Name="_WxsgSuppressMarkupGeneratedVisualBasicCompile"
          AfterTargets="MarkupCompilePass1"
          BeforeTargets="CoreCompile"
          Condition="'$(WpfXsgEnabled)' == 'true' and '$(WpfXsgVisualBasicMode)' == 'true' and !$(MSBuildProjectName.Contains('_wpftmp'))">
    <ItemGroup>
      <Compile Remove="@(Compile)"
               Condition="'%(Compile.AutoGen)' == 'True' and ($([System.String]::Copy('%(Compile.Identity)').EndsWith('.g.vb')) or $([System.String]::Copy('%(Compile.Identity)').EndsWith('.g.i.vb')))" />
    </ItemGroup>
  </Target>

  <Target Name="_WxsgWarnUnsupportedLanguage"
          BeforeTargets="PrepareForBuild"
          Condition="'$(WpfXsgEnabled)' == 'true' and '$(WpfXsgLanguageSupported)' != 'true' and !$(MSBuildProjectName.Contains('_wpftmp'))">
    <Message Importance="High"
             Text="WXSG target language '$(WpfXsgTargetLanguage)' is not currently supported for project language '$(Language)'. The build will fall back to the default WPF markup compiler." />
  </Target>

  <Target Name="_WxsgWarnFSharpGeneratorLimitation"
          BeforeTargets="PrepareForBuild"
          Condition="'$(WpfXsgEnabled)' == 'true' and '$(Language)' == 'F#' and !$(MSBuildProjectName.Contains('_wpftmp'))">
    <Message Importance="High"
             Text="WXSG F# mode uses an MSBuild prototype path (generated .g.fs + loose XAML copy). Roslyn source generators are unavailable in F# compilation." />
  </Target>

  <!--
    Inline task: write a MarkupCompilePass2 .lref cache file for a given list of XAML files.
    Format (from MS.Internal.Tasks.CompilerLocalReference / LocalReferenceFile.Serialize):
      Line 1: InternalTypeHelperFile path (empty if not needed)
      Line 2: LocalApplicationFile serialized (empty for libraries)
      Line 3+: F<absolute-path>;<LinkAlias>;<LogicalName>
    'F' means the file failed Pass1 and needs Pass2 with local type assembly.
  -->
  <UsingTask TaskName="WxsgWriteLrefFile"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <LocalMarkupPages ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var sb = new StringBuilder();
        sb.AppendLine("");   // line 1: InternalTypeHelperFile (empty)
        sb.AppendLine("");   // line 2: LocalApplicationFile (empty for non-application)
        foreach (var page in LocalMarkupPages ?? Array.Empty<ITaskItem>())
        {
            var path = page.GetMetadata("FullPath");
            if (string.IsNullOrEmpty(path)) path = page.ItemSpec;
            var linkAlias    = page.GetMetadata("Link") ?? "";
            var logicalName  = page.GetMetadata("LogicalName") ?? "";
            sb.AppendLine("F" + path + ";" + linkAlias + ";" + logicalName);
        }
        var dir = Path.GetDirectoryName(OutputFile);
        if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
        // Write without BOM — MarkupCompilePass2 reads without BOM detection.
        File.WriteAllText(OutputFile, sb.ToString(), new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Task that rewrites the compiled assembly to inject BAML into .g.resources.
       Select the task binary for the MSBuild host runtime, not for the target project TFM. -->
  <PropertyGroup>
    <_WxsgInjectBamlTaskTfm Condition="'$(MSBuildRuntimeType)' == 'Core'">net8.0</_WxsgInjectBamlTaskTfm>
    <_WxsgInjectBamlTaskTfm Condition="'$(MSBuildRuntimeType)' != 'Core'">net48</_WxsgInjectBamlTaskTfm>
    <_WxsgPackagedInjectBamlTaskAssembly>$(MSBuildThisFileDirectory)tasks\$(_WxsgInjectBamlTaskTfm)\XamlToCSharpGenerator.Build.Tasks.dll</_WxsgPackagedInjectBamlTaskAssembly>
    <_WxsgSourceInjectBamlTaskAssembly>$(MSBuildThisFileDirectory)..\..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\$(_WxsgInjectBamlTaskTfm)\XamlToCSharpGenerator.Build.Tasks.dll</_WxsgSourceInjectBamlTaskAssembly>
  </PropertyGroup>

  <UsingTask TaskName="XamlToCSharpGenerator.Build.Tasks.WxsgInjectBamlTask"
             AssemblyFile="$(_WxsgPackagedInjectBamlTaskAssembly)"
             Condition="Exists('$(_WxsgPackagedInjectBamlTaskAssembly)')" />

  <UsingTask TaskName="XamlToCSharpGenerator.Build.Tasks.WxsgInjectBamlTask"
             AssemblyFile="$(_WxsgSourceInjectBamlTaskAssembly)"
             Condition="!Exists('$(_WxsgPackagedInjectBamlTaskAssembly)') and Exists('$(_WxsgSourceInjectBamlTaskAssembly)')" />

  <!--
    Post-CoreCompile BAML bypass: generate BAML for classless pages that were removed from
    @(Page) in _WxsgPrepareXamlCSharp to prevent _wpftmp from being triggered.
    MarkupCompilePass2 is invoked here with the real compiled assembly as the local-type
    reference, so {x:Type local:Foo} can be resolved without a temporary project.
    WxsgInjectBamlTask then rewrites the assembly to embed the generated BAML into
    the .g.resources manifest resource so WPF BAML template loading works at runtime.
  -->
  <Target Name="_WxsgBamlBypass"
          AfterTargets="CoreCompile"
          Condition="'$(WpfXsgEnabled)' == 'true' and '$(WpfXsgCSharpMode)' == 'true' and '@(_WxsgDeferredClasslessPage)' != '' and !$(MSBuildProjectName.Contains('_wpftmp'))">

    <Message Importance="High"
             Text="[WXSG_DEBUG] _WxsgBamlBypass: starting post-CoreCompile BAML bypass for project=$(MSBuildProjectName)"
             Condition="'$(WXSG_DEBUG)' != ''" />
    <Message Importance="High"
             Text="[WXSG_DEBUG] _WxsgBamlBypass: deferred-classless-pages=@(_WxsgDeferredClasslessPage)"
             Condition="'$(WXSG_DEBUG)' != ''" />

    <WxsgWriteLrefFile
        LocalMarkupPages="@(_WxsgDeferredClasslessPage)"
        OutputFile="$(IntermediateOutputPath)$(AssemblyName)_MarkupCompile.lref" />

    <!-- After CoreCompile the assembly lives in IntermediateOutputPath, not TargetPath yet
         (CopyFilesToOutputDirectory hasn't run). Add it so Pass2 can resolve local types. -->
    <PropertyGroup>
      <_WxsgCompiledAssemblyPath>$(IntermediateOutputPath)$(TargetFileName)</_WxsgCompiledAssemblyPath>
    </PropertyGroup>
    <ItemGroup>
      <_WxsgPass2References Include="@(ReferencePath)" />
      <_WxsgPass2References Include="$(_WxsgCompiledAssemblyPath)"
                            Condition="$([System.IO.File]::Exists('$(_WxsgCompiledAssemblyPath)'))" />
    </ItemGroup>

    <Message Importance="High"
             Text="[WXSG_DEBUG] _WxsgBamlBypass: compiled-assembly=$(_WxsgCompiledAssemblyPath)"
             Condition="'$(WXSG_DEBUG)' != ''" />

    <MarkupCompilePass2
        AssemblyName="$(AssemblyName)"
        Language="$(Language)"
        OutputPath="$(IntermediateOutputPath)"
        OutputType="$(OutputType)"
        References="@(_WxsgPass2References)" />

    <Message Importance="High"
             Text="[WXSG_DEBUG] _WxsgBamlBypass: MarkupCompilePass2 completed"
             Condition="'$(WXSG_DEBUG)' != ''" />

    <!-- Collect the BAML files produced by MarkupCompilePass2 for each deferred page -->
    <ItemGroup>
      <_WxsgGeneratedBaml Include="$(IntermediateOutputPath)%(_WxsgDeferredClasslessPage.RecursiveDir)%(_WxsgDeferredClasslessPage.Filename).baml"
                          Condition="$([System.IO.File]::Exists('$(IntermediateOutputPath)%(_WxsgDeferredClasslessPage.RecursiveDir)%(_WxsgDeferredClasslessPage.Filename).baml'))" />
    </ItemGroup>

    <Message Importance="High"
             Text="[WXSG_DEBUG] _WxsgBamlBypass: generated-baml=@(_WxsgGeneratedBaml)"
             Condition="'$(WXSG_DEBUG)' != ''" />

    <!-- Inject BAML into the compiled assembly's .g.resources -->
    <XamlToCSharpGenerator.Build.Tasks.WxsgInjectBamlTask
        AssemblyPath="$(_WxsgCompiledAssemblyPath)"
        BamlFiles="@(_WxsgGeneratedBaml)"
        AssemblyName="$(AssemblyName)"
        ProjectDirectory="$(IntermediateOutputPath)"
        Condition="'@(_WxsgGeneratedBaml)' != '' and $([System.IO.File]::Exists('$(_WxsgCompiledAssemblyPath)'))" />

    <Message Importance="Normal"
             Text="WXSG BamlBypass: injected BAML for @(_WxsgDeferredClasslessPage) into $(TargetFileName)." />
  </Target>
</Project>
