<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XamlToCSharpGenerator.Generator.WPF</RootNamespace>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageId>XamlToCSharpGenerator.Generator.WPF</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version Condition="'$(Version)' == '' and '$(GitVersion_NuGetVersionV2)' != ''">$(GitVersion_NuGetVersionV2)</Version>
    <Description>WPF XAML source generator (WXSG) — generates typed InitializeComponent from WPF Page items.</Description>
    <PackageTags>wpf;analyzer;generator;roslyn;xaml</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XamlToCSharpGenerator.WPF\XamlToCSharpGenerator.WPF.csproj" />
    <ProjectReference Include="..\..\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.Compiler\XamlToCSharpGenerator.Compiler.csproj" />
    <ProjectReference Include="..\..\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.Core\XamlToCSharpGenerator.Core.csproj" />
    <ProjectReference Include="..\..\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.ExpressionSemantics\XamlToCSharpGenerator.ExpressionSemantics.csproj" />
    <ProjectReference Include="..\..\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.Framework.Abstractions\XamlToCSharpGenerator.Framework.Abstractions.csproj" />
    <ProjectReference Include="..\..\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.MiniLanguageParsing\XamlToCSharpGenerator.MiniLanguageParsing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" Version="6.0.5" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.10.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Bundle the Build.WPF props/targets into the package's buildTransitive folder.
    This means consumers only need a single PackageReference — no separate Build.WPF reference.
  -->
  <!--
    Bundle Build.WPF props/targets under the package ID name so NuGet auto-imports them.
    NuGet only auto-imports buildTransitive/{PackageId}.props and .targets.
  -->
  <ItemGroup>
    <None Include="..\XamlToCSharpGenerator.Build.WPF\buildTransitive\XamlToCSharpGenerator.Build.WPF.props"
          Pack="true"
          PackagePath="build\XamlToCSharpGenerator.Generator.WPF.props" />
    <None Include="..\XamlToCSharpGenerator.Build.WPF\buildTransitive\XamlToCSharpGenerator.Build.WPF.targets"
          Pack="true"
          PackagePath="build\XamlToCSharpGenerator.Generator.WPF.targets" />
    <None Include="..\XamlToCSharpGenerator.Build.WPF\buildTransitive\XamlToCSharpGenerator.Build.WPF.props"
          Pack="true"
          PackagePath="buildTransitive\XamlToCSharpGenerator.Generator.WPF.props" />
    <None Include="..\XamlToCSharpGenerator.Build.WPF\buildTransitive\XamlToCSharpGenerator.Build.WPF.targets"
          Pack="true"
          PackagePath="buildTransitive\XamlToCSharpGenerator.Generator.WPF.targets" />
  </ItemGroup>

  <!-- Include README from wxsg root -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <!-- Bundle all required assemblies into the NuGet analyzer path -->
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.WPF.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.Compiler.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.Core.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.ExpressionSemantics.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.Framework.Abstractions.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.MiniLanguageParsing.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />

    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/vb" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.WPF.dll" Pack="true" PackagePath="analyzers/dotnet/vb" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.Compiler.dll" Pack="true" PackagePath="analyzers/dotnet/vb" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.Core.dll" Pack="true" PackagePath="analyzers/dotnet/vb" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.ExpressionSemantics.dll" Pack="true" PackagePath="analyzers/dotnet/vb" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.Framework.Abstractions.dll" Pack="true" PackagePath="analyzers/dotnet/vb" Visible="false" />
    <None Include="$(OutputPath)XamlToCSharpGenerator.MiniLanguageParsing.dll" Pack="true" PackagePath="analyzers/dotnet/vb" Visible="false" />
  </ItemGroup>

  <!-- Include task binaries under buildTransitive/tasks/<TFM> so targets can select by MSBuildRuntimeType. -->
  <ItemGroup>
    <None Include="..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net8.0\*"
          Exclude="..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net8.0\Microsoft.Build.*;..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net8.0\Microsoft.NET.StringTools.*"
          Pack="true"
          PackagePath="buildTransitive\tasks\net8.0"
          Visible="false"
          Condition="Exists('..\\XamlToCSharpGenerator.Build.Tasks\\bin\\$(Configuration)\\net8.0\\XamlToCSharpGenerator.Build.Tasks.dll')" />
    <None Include="..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net48\*"
          Exclude="..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net48\Microsoft.Build.*;..\XamlToCSharpGenerator.Build.Tasks\bin\$(Configuration)\net48\Microsoft.NET.StringTools.*"
          Pack="true"
          PackagePath="buildTransitive\tasks\net48"
          Visible="false"
          Condition="Exists('..\\XamlToCSharpGenerator.Build.Tasks\\bin\\$(Configuration)\\net48\\XamlToCSharpGenerator.Build.Tasks.dll')" />
  </ItemGroup>

  <!-- Ensure the Build.Tasks project is built when creating the NuGet package so the task assets exist to be packed. -->
  <Target Name="BuildXamlToCSharpGeneratorBuildTasks" BeforeTargets="Pack"
          Condition="Exists('..\\XamlToCSharpGenerator.Build.Tasks\\XamlToCSharpGenerator.Build.Tasks.csproj')">
    <MSBuild Projects="..\XamlToCSharpGenerator.Build.Tasks\XamlToCSharpGenerator.Build.Tasks.csproj"
         Targets="Restore"
         Properties="Configuration=$(Configuration)"
         StopOnFirstFailure="true" />
    <MSBuild Projects="..\XamlToCSharpGenerator.Build.Tasks\XamlToCSharpGenerator.Build.Tasks.csproj"
         Targets="Build"
         Properties="Configuration=$(Configuration);TargetFramework=net8.0;NoBuild=false"
         StopOnFirstFailure="true" />
    <MSBuild Projects="..\XamlToCSharpGenerator.Build.Tasks\XamlToCSharpGenerator.Build.Tasks.csproj"
         Targets="Build"
         Properties="Configuration=$(Configuration);TargetFramework=net48;NoBuild=false"
         StopOnFirstFailure="true" />
  </Target>
</Project>
