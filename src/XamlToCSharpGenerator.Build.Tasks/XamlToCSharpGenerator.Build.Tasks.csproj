<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>XamlToCSharpGenerator.Build.Tasks</RootNamespace>
    <AssemblyName>XamlToCSharpGenerator.Build.Tasks</AssemblyName>
    <!-- Task assemblies must not copy themselves to output since MSBuild loads them directly -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UseNuGetPackage>false</UseNuGetPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.4.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.4.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="2.2.0" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNuGetPackage)' == 'true'">
    <!-- Prefer consuming the packed NuGet package instead of a local project ref -->
    <PackageReference Include="LeXtudio.Metadata.Mutable" Version="0.9.5" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNuGetPackage)' != 'true'">
    <!-- For local development, reference the project directly -->
    <ProjectReference Include="..\..\external\metadata\src\LeXtudio.Metadata.Mutable\LeXtudio.Metadata.Mutable.csproj">
      <AdditionalProperties>EnableGitVersionMsBuild=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
