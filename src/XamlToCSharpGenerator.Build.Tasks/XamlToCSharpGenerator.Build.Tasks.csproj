<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>XamlToCSharpGenerator.Build.Tasks</RootNamespace>
    <AssemblyName>XamlToCSharpGenerator.Build.Tasks</AssemblyName>
    <!-- Task assemblies must not copy themselves to output since MSBuild loads them directly -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="17.10.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.10.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Prefer consuming the packed NuGet package instead of a local project ref -->
    <PackageReference Include="LeXtudio.Metadata.Mutable" Version="0.9.0" />
  </ItemGroup>
</Project>
