<Window x:Class="PathStyleTriggerSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Path Style Trigger Sample" Height="200" Width="320">
    <!--
      Issue 1 (lextudio/wxsg#12): <Style TargetType="Path"> in the WPF presentation
      namespace must resolve to System.Windows.Shapes.Path, not System.IO.Path.
      Resolving to System.IO.Path causes:
        "Path type must be derived from FrameworkElement or FrameworkContentElement"
      at Style.set_TargetType. The Window will fail to load and the App's
      DispatcherUnhandledException will exit non-zero before WXSG-SAMPLE-OK.

      Issue 2 (lextudio/wxsg#12): A DataTrigger Value="False" against a bool source
      property must compare correctly at runtime. The self-check sets DataContext
      with IsInput=false and asserts the trigger Setter for Stroke=Blue applied,
      proving the comparison works whether Value was emitted as "False" or false.
    -->
    <Window.Resources>
        <Style x:Key="StyleIOPath" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Stroke" Value="#f28D26" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Data" Value="F1 M 47,50 L 1,50 M 26,35 L 1,51 M 27,66 L 1,49 M 1,34 L 1,68" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInput, Mode=OneTime}" Value="False">
                    <Setter Property="Data" Value="F1 M 10,50 L 47,50 M 30,33 L 47,51 M 30,67 L 47,49 M 8,35 L 8,67" />
                    <Setter Property="Stroke" Value="Blue" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Path x:Name="probePath" Style="{StaticResource StyleIOPath}" />
    </Grid>
</Window>
