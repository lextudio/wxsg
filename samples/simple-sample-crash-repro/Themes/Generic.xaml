<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SimpleSampleCrashRepro">
    <ResourceDictionary.MergedDictionaries>
        <local:VersionedAssemblyResourceDictionary Source="/SimpleSampleCrashRepro;component/DesignSurface.xaml" />
        <local:VersionedAssemblyResourceDictionary Source="/SimpleSampleCrashRepro;component/OutlineView/OutlineView.xaml" />
        <local:VersionedAssemblyResourceDictionary Source="/SimpleSampleCrashRepro;component/PropertyGrid/PropertyGridView.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:ProbeControl}">
        <Setter Property="Width" Value="12" />
    </Style>
</ResourceDictionary>
