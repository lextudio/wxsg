<Window x:Class="AncestorTypeNamespaceCollisionSample.Mapping.Mapping"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AncestorTypeNamespaceCollisionSample.Mapping"
        Title="Ancestor Type Namespace Collision"
        Width="320"
        Height="180">
  <StackPanel Margin="16">
    <TextBlock x:Name="AncestorText"
               Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Mapping}}, Path=HeaderText}" />
    <TextBlock Margin="0,8,0,0"
               Text="{x:Static local:Mapping.StaticText}" />
  </StackPanel>
</Window>