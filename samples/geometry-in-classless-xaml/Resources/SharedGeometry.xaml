<!--
  Classless ResourceDictionary containing an abstract Geometry type initialised
  from a text node (path data string).

  This is the same pattern as SharpDevelop's QueryView.xaml:
    <Geometry x:Key="DownArrowGeometry">M 0 0 L 3.5 4 L 7 0 Z</Geometry>

  Abstract types like Geometry are only instantiable via a TypeConverter that
  parses the text content. WXSG must emit typeof(Geometry) with a TypeConverter
  invocation rather than attempting new Geometry(), which would fail to compile.

  This classless XAML is deferred through _WxsgBamlBypass and embedded as a
  raw Resource, so __WxsgThemeLoader can load it via Application.GetResourceStream.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Geometry x:Key="DownArrowGeometry">M 0 0 L 3.5 4 L 7 0 Z</Geometry>
    <Geometry x:Key="UpArrowGeometry">M 0 4 L 3.5 0 L 7 4 Z</Geometry>
    <Geometry x:Key="RightArrowGeometry">M 0 0 L 4 3.5 L 0 7 Z</Geometry>
</ResourceDictionary>
