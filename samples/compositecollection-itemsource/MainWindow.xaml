<Window x:Class="CompositeCollectionItemsSourceSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CompositeCollection ItemsSource Sample" Height="240" Width="320">
    <Grid>
        <ComboBox x:Name="SampleComboBox" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="12">
            <ComboBox.ItemsSource>
                <CompositeCollection>
                    <CollectionContainer x:Name="StaticItems" />
                    <CollectionContainer x:Name="DynamicItems" />
                </CompositeCollection>
            </ComboBox.ItemsSource>
        </ComboBox>
    </Grid>
</Window>