<local:BaseWindow x:Class = "WindowCustomBaseSample.SecondWindow"
        xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local = "clr-namespace:WindowCustomBaseSample"
        Title = "Second Window"
        Width = "400" Height = "300">
    <!--
      Regression: x:Class = "..." (with spaces around =) must be recognized as a classed
      page. Previously Contains('x:Class=') missed this form and misclassified the file as
      classless, so InitializeComponent was never generated (pattern from SharpDevelop's
      WpfWorkbench.xaml).
    -->
    <Grid>
        <TextBlock x:Name="probe" Text="Second Window" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</local:BaseWindow>
