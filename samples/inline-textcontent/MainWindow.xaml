<Window x:Class="InlineTextContentSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inline Text Content"
        Width="320"
        Height="180">
  <StackPanel Margin="16">
    <TextBlock x:Name="PlainTextBlock">Plain inline text</TextBlock>
    <TextBlock Margin="0,8,0,0">
      <Span>Nested span inline text</Span>
    </TextBlock>
    <!-- Regression: multi-line text node content must have \n and \t escaped in the
         generated string literal; previously AsStringLiteral() emitted raw newlines
         causing CS1010 "Newline in constant" in the generated .g.cs file. -->
    <TextBlock TextWrapping="WrapWithOverflow" Margin="0,8,0,0">
      <Run x:Name="MultiLineRun">This text spans
        multiple lines with tabs	and newlines.</Run>
    </TextBlock>
  </StackPanel>
</Window>