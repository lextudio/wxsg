<Window x:Class="GeometryTextNodeSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Geometry Text Node Sample" Height="200" Width="300">
    <Window.Resources>
        <Geometry x:Key="DownArrowGeometry">M 0 0 L 2 3 L 4 0 Z</Geometry>
    </Window.Resources>
    <Grid>
        <Path Data="{StaticResource DownArrowGeometry}" Fill="Black" Width="24" Height="24" />
    </Grid>
</Window>